name: Build Mainline RK3566 OS

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build-os:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Install Build Dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y \
          build-essential gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
          bison flex libssl-dev bc libncurses-dev kmod u-boot-tools \
          device-tree-compiler python3 python3-pyelftools python3-setuptools \
          swig libelf-dev libgnutls28-dev rsync git wget \
          parted kpartx e2fsprogs dosfstools qemu-user-static debootstrap

    - name: Fetch Sources
      run: |
        git clone --depth 1 https://source.denx.de/u-boot/u-boot.git uboot
        git clone --depth 1 --branch v6.12 https://github.com/torvalds/linux.git kernel
        git clone --depth 1 https://github.com/rockchip-linux/rkbin.git rkbin
        git clone --depth 1 https://github.com/ROCKNIX/distribution.git rocknix-src

    - name: Build Mainline U-Boot
      run: |
        cd uboot
        export ARCH=arm64
        export CROSS_COMPILE=aarch64-linux-gnu-

        make powkiddy-x55-rk3566_defconfig

        BL31=$(ls ../rkbin/bin/rk35/rk3568_bl31_v*.elf | sort -V | tail -n1)
        TPL=$(ls ../rkbin/bin/rk35/rk3566_ddr_1056MHz_v*.bin | sort -V | tail -n1)

        echo "--> BL31=$BL31"
        echo "--> DDR/TPL=$TPL"

        make BL31="$BL31" ROCKCHIP_TPL="$TPL" -j"$(nproc)"

    - name: Prepare Kernel Patches and Drivers
      run: |
        mkdir -p rocknix-patches rocknix-dts
        
        ROCKNIX_KCONFIG=$(find rocknix-src -path '*RK3566*/linux/linux.aarch64.conf' | head -n1)
        cp "$ROCKNIX_KCONFIG" rocknix-kernel.config

        find rocknix-src \(-iname '*x55*' -o -iname '*x35*'\) -type f > /tmp/x35-files.txt

        while read -r f; do
          case "$f" in
            *.patch) cp "$f" rocknix-patches/ ;;
            *.dts|*.dtsi) cp "$f" rocknix-dts/ ;;
          esac
        done < /tmp/x35-files.txt

        GENERIC_DSI_C=$(find rocknix-src -iname 'panel-generic-dsi.c' | head -n1)
        if [ -n "$GENERIC_DSI_C" ]; then
          cp "$GENERIC_DSI_C" rocknix-panel-generic-dsi.c
        fi

    - name: Build Mainline Kernel
      run: |
        cd kernel
        export ARCH=arm64
        export CROSS_COMPILE=aarch64-linux-gnu-

        for p in ../rocknix-patches/*.patch; do
          [ -f "$p" ] || continue
          git apply --reject --whitespace=fix "$p" || true
        done

        if ls ../rocknix-dts/*.dts* >/dev/null 2>&1; then
          cp ../rocknix-dts/*.dts* arch/arm64/boot/dts/rockchip/
        fi

        MAKEFILE="arch/arm64/boot/dts/rockchip/Makefile"
        for dtsfile in arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x35*.dts \
                       arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55.dts; do
          [ -f "$dtsfile" ] || continue
          base=$(basename "$dtsfile" .dts)
          grep -q "${base}\.dtb" "$MAKEFILE" || echo "dtb-\$(CONFIG_ARCH_ROCKCHIP) += ${base}.dtb" >> "$MAKEFILE"
        done

        cp ../rocknix-kernel.config .config
        ./scripts/config --set-str CONFIG_INITRAMFS_SOURCE ""

        # Driver de Painel MIPI-DSI Generico (ROCKNIX)
        if [ -f ../rocknix-panel-generic-dsi.c ]; then
          cp ../rocknix-panel-generic-dsi.c drivers/gpu/drm/panel/panel-generic-dsi.c
          if ! grep -q "panel-generic-dsi.o" drivers/gpu/drm/panel/Makefile; then
            echo "obj-\$(CONFIG_DRM_PANEL_GENERIC_DSI) += panel-generic-dsi.o" >> drivers/gpu/drm/panel/Makefile
          fi
          ./scripts/config --enable CONFIG_DRM
          ./scripts/config --enable CONFIG_DRM_MIPI_DSI
          ./scripts/config --enable CONFIG_DRM_PANEL_GENERIC_DSI
        fi

        # Drivers de Botoes e Controles
        ./scripts/config --enable CONFIG_JOYSTICK_ADC
        ./scripts/config --enable CONFIG_KEYBOARD_GPIO
        ./scripts/config --enable CONFIG_KEYBOARD_ADC
        ./scripts/config --enable CONFIG_INPUT_JOYSTICK
        ./scripts/config --enable CONFIG_INPUT_EVDEV

        # Módulos USB Gadget Ethernet (Rede via cabo USB-C)
        ./scripts/config --enable CONFIG_USB_GADGET
        ./scripts/config --enable CONFIG_USB_DWC3
        ./scripts/config --enable CONFIG_USB_DWC3_DUAL_ROLE
        ./scripts/config --enable CONFIG_USB_ROLE_SWITCH
        ./scripts/config --module CONFIG_USB_LIBCOMPOSITE
        ./scripts/config --module CONFIG_USB_ETH
        ./scripts/config --enable CONFIG_USB_ETH_RNDIS

        make olddefconfig
        make -j"$(nproc)" Image dtbs modules

    - name: Build Minimal RootFS (Debian ARM64)
      run: |
        sudo debootstrap --arch=arm64 --foreign bookworm rootfs http://deb.debian.org/debian/
        sudo cp /usr/bin/qemu-aarch64-static rootfs/usr/bin/
        sudo chroot rootfs /debootstrap/debootstrap --second-stage

        sudo mount -t proc /proc rootfs/proc
        sudo mount -t sysfs /sys rootfs/sys
        sudo mount --bind /dev rootfs/dev

        sudo chroot rootfs bash -c '
          export DEBIAN_FRONTEND=noninteractive
          apt-get update
          apt-get install -y --no-install-recommends \
            systemd-sysv udev ifupdown network-manager openssh-server sudo nano \
            kodi kodi-bin kodi-peripheral-joystick libgl1-mesa-dri libegl-mesa0 libgbm1 libgles2 \
            alsa-utils dbus ca-certificates iproute2
          echo "root:root" | chpasswd
          echo "rk3566-device" > /etc/hostname
          apt-get clean
          rm -rf /var/lib/apt/lists/*
        '

        # Script para subir o USB Gadget Ethernet com IP Fixo 192.168.7.2
        sudo bash -c 'cat << "EOF" > rootfs/usr/local/bin/setup-usb-gadget.sh
#!/bin/sh
modprobe g_ether host_addr=00:dc:c8:fe:52:99 dev_addr=00:dc:c8:fe:52:88

while [ ! -d /sys/class/net/usb0 ]; do
    sleep 0.2
done

ip link set dev usb0 up
ip addr add 192.168.7.2/24 dev usb0
EOF'
        sudo chmod +x rootfs/usr/local/bin/setup-usb-gadget.sh

        # Servico Systemd para executar o script no boot
        sudo bash -c 'cat << "EOF" > rootfs/etc/systemd/system/usb-gadget.service
[Unit]
Description=USB Ethernet Gadget Setup
After=systemd-modules-load.service
Before=network.target openssh-server.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-usb-gadget.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF'

        sudo chroot rootfs systemctl enable usb-gadget.service

        # Servico do Kodi Media Center (DRM/GBM)
        sudo bash -c 'cat << "EOF" > rootfs/etc/systemd/system/kodi.service
[Unit]
Description=Kodi Media Center (GBM)
After=systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service

[Service]
User=root
Environment=HOME=/root
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/bin/kodi --standalone --windowing=gbm
Restart=always

[Install]
WantedBy=multi-user.target
EOF'

        sudo chroot rootfs systemctl enable kodi.service

        sudo umount rootfs/dev
        sudo umount rootfs/sys
        sudo umount rootfs/proc

        cd kernel
        sudo make ARCH=arm64 INSTALL_MOD_PATH=../rootfs modules_install
        cd ..

    - name: Create SD Card Image (.img)
      run: |
        sudo bash << 'EOF'
        set -e

        IMAGE_NAME="rk3566-mainline-sdcard.img"
        dd if=/dev/zero of=${IMAGE_NAME} bs=1M count=3500 status=progress

        parted -s ${IMAGE_NAME} mklabel msdos
        parted -s ${IMAGE_NAME} mkpart primary fat32 16MiB 144MiB
        parted -s ${IMAGE_NAME} mkpart primary ext4 144MiB 100%

        LOOP_DEV=$(losetup -fP --show${IMAGE_NAME})
        BOOT_DEV="${LOOP_DEV}p1"
        ROOT_DEV="${LOOP_DEV}p2"

        mkfs.vfat -F 32 -n "BOOT" ${BOOT_DEV}
        mkfs.ext4 -F -L "ROOTFS" ${ROOT_DEV}

        dd if=uboot/idbloader.img of=${LOOP_DEV} seek=64 conv=notrunc,fsync
        dd if=uboot/u-boot.itb of=${LOOP_DEV} seek=16384 conv=notrunc,fsync

        mkdir -p /mnt/boot /mnt/rootfs
        mount ${BOOT_DEV} /mnt/boot
        mount ${ROOT_DEV} /mnt/rootfs

        cp kernel/arch/arm64/boot/Image /mnt/boot/
        mkdir -p /mnt/boot/dtbs
        cp kernel/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-*.dtb /mnt/boot/dtbs/ 2>/dev/null || true

        mkdir -p /mnt/boot/extlinux
        cat << "BOOTCFG" > /mnt/boot/extlinux/extlinux.conf
TIMEOUT 30
DEFAULT X35S

LABEL X35S
    MENU LABEL Powkiddy X35S / X35H
    KERNEL /Image
    FDT /dtbs/rk3566-powkiddy-x35s.dtb
    APPEND quiet rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 console=tty1 root=LABEL=ROOTFS rw

LABEL X55
    MENU LABEL Powkiddy X55 (Mainline)
    KERNEL /Image
    FDT /dtbs/rk3566-powkiddy-x55.dtb
    APPEND quiet rootwait earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 console=tty1 root=LABEL=ROOTFS rw
BOOTCFG

        cp -a rootfs/* /mnt/rootfs/

        umount /mnt/boot
        umount /mnt/rootfs
        losetup -d ${LOOP_DEV}

        gzip -f ${IMAGE_NAME}
        EOF

    - name: Upload SD Card Image
      uses: actions/upload-artifact@v4
      with:
        name: rk3566-mainline-sdcard-image
        path: rk3566-mainline-sdcard.img.gz
