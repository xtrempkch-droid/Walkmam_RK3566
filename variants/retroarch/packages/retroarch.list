# Pacotes da variante "retroarch" (versão de jogos).
#
# IMPORTANTE — como validar um nome antes de acrescentar:
# NÃO confie em https://packages.debian.org/bookworm/arm64/<pacote>: ele devolve
# HTTP 200 mesmo quando o pacote não existe para a arquitetura (é uma página de
# erro). A fonte da verdade é o índice da arquitetura:
#
#   curl -s http://deb.debian.org/debian/dists/bookworm/main/binary-arm64/Packages.gz \
#     | zcat | grep -c '^Package: <nome>$'
#
# Isso importa: libretro-fceumm, libretro-snes9x, libretro-genesisplusgx e
# libretro-pcsx-rearmed NÃO existem para arm64 (o apt falha com "não é possível
# encontrar o pacote"), embora existam para amd64/armhf.

retroarch
retroarch-assets
libretro-core-info

# O que o arm64 do bookworm realmente tem (conferido no índice):
#   NES ................. libretro-nestopia
#   SNES ................ libretro-bsnes-mercury-{accuracy,balanced,performance}
#   GB/GBC .............. libretro-gambatte
#   GBA ................. libretro-mgba
#   PC Engine ........... libretro-beetle-pce-fast
#   PlayStation 1 ....... libretro-beetle-psx  (EXIGE BIOS, ver abaixo)
#   Virtual Boy ......... libretro-beetle-vb
#   WonderSwan .......... libretro-beetle-wswan
#   Nintendo DS ......... libretro-desmume    (pesado; não incluído)

libretro-nestopia
libretro-bsnes-mercury-balanced
libretro-gambatte
libretro-mgba
libretro-beetle-pce-fast

# PlayStation 1: é o único core de PS1 para arm64, e ele PRECISA de BIOS
# (scph5500.bin / scph5501.bin / scph5502.bin) em /storage/bios. A BIOS não é
# distribuída com o projeto; sem ela o core não roda jogo.
libretro-beetle-psx

# Ambiente gráfico e áudio (mesmos pacotes do Kodi: já validados no aparelho)
weston
libgl1-mesa-dri
libegl-mesa0
libgbm1
libgles2
libinput10
evtest
alsa-utils
dbus
ca-certificates

# Rádio (o RetroArch também não tem UI de Wi-Fi/BT; o painel web :8088 usa isto)
wpasupplicant
iw
wireless-tools
rfkill
bluez
busybox
