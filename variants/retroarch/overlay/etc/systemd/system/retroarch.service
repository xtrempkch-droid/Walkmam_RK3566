[Unit]
Description=RetroArch (Weston/Wayland) no tty1
After=systemd-user-sessions.service systemd-udev-settle.service sound.target
Conflicts=getty@tty1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=root
Environment=HOME=/root
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/local/bin/start-retroarch.sh
# Igual ao kodi.service: em falha tenta poucas vezes e para, deixando o motivo
# visível na tela (evita o loop rápido que apaga a mensagem).
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
