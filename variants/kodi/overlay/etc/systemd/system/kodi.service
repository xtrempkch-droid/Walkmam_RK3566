[Unit]
Description=Kodi Media Center (Weston/Wayland)
After=systemd-user-sessions.service systemd-udev-settle.service sound.target
Conflicts=getty@tty1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=root
Environment=HOME=/root
Environment=KODI_AE_SINK=ALSA
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/local/bin/start-kodi-wayland.sh
# on-failure com RestartSec alto: em falha, tenta poucas vezes e para, deixando
# o motivo visível na tela (evita o loop rápido que apagava a mensagem).
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
